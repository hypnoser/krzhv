      <tr><td class="day">7<small>Дата:</small></td><td><div class="cell"><div class="lined"></div><div class="mood">Настрій: ____ /10</div></div></td><td><div class="cell"><div class="lined"></div><div class="mood">Настрій: ____ /10</div></div></td><td><div class="cell"><div class="lined"></div><div class="mood">Настрій: ____ /10</div></div></td></tr>
