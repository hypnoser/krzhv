<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Бланки для записів — матеріали для початку роботи | krzhv.com.ua</title>
<style>
:root{
  --sage:#3D5A4A; --sage-d:#2C4336; --terra:#C77A4F; --terra-d:#9A5530;
  --sand-l:#F7F2EA; --ink:#1E2923; --muted:#4F5E55; --line:#B9C4BC; --rule:#D5DDD7;
  --serif:'Merriweather',Georgia,'Times New Roman',serif;
  --sans:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;
}
*{box-sizing:border-box}
body{margin:0;background:#E9E6DF;color:var(--ink);font:15px/1.5 var(--sans);-webkit-print-color-adjust:exact;print-color-adjust:exact}
a,button{color:var(--sage)}
a:focus-visible,button:focus-visible{outline:3px solid var(--terra);outline-offset:2px}
.toolbar{position:sticky;top:0;z-index:2;background:var(--sage);color:#fff}
.toolbar .in{max-width:210mm;margin:0 auto;padding:12px 16px;display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between}
.toolbar a{color:#fff;font-weight:600}
.toolbar button{background:#fff;color:var(--sage-d);border:0;border-radius:8px;padding:10px 18px;font:600 15px var(--sans);cursor:pointer}
.hint{max-width:210mm;margin:16px auto 0;padding:0 16px;color:var(--muted);font-size:14px}
.pages{overflow-x:auto;padding:16px 0 40px}
.sheet{width:210mm;min-height:297mm;margin:0 auto 16px;background:#fff;padding:12mm;box-shadow:0 1px 3px rgba(30,41,35,.18);display:flex;flex-direction:column}
.sheet h1{font:700 18pt/1.25 var(--serif);color:var(--sage-d);margin:0 0 2mm}
.sheet .sub{font-size:10pt;color:var(--muted);margin:0 0 5mm}
.sheet .foot{margin-top:auto;padding-top:3mm;font-size:8.5pt;color:var(--muted);display:flex;justify-content:space-between}
table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:9.5pt}
th{background:var(--sand-l);text-align:left;font-weight:600;padding:2mm;border:1px solid var(--line)}
td{border:1px solid var(--line);padding:1.5mm 2mm;vertical-align:top}
.lined{background-image:repeating-linear-gradient(to bottom,transparent 0,transparent 7mm,var(--rule) 7mm,var(--rule) calc(7mm + 1px))}
.w1 td{height:29mm}
.w1 .cell{display:flex;flex-direction:column;height:100%;min-height:26mm}
.w1 .cell .lined{flex:1}
.mood{font-size:8.5pt;color:var(--muted);margin-top:1mm}
.day{font-weight:600;font-size:9pt}
.day small{display:block;font-weight:400;color:var(--muted);margin-top:6mm}
.w2 td{height:22mm}
.box{border:1px solid var(--line);border-radius:3mm;padding:3mm 4mm;margin:0 0 5mm}
.box b{font-family:var(--serif);font-size:10.5pt;color:var(--sage-d)}
.box .lined{height:21mm;margin-top:1mm}
.groups{font-size:9pt;color:var(--muted);margin:0 0 3mm}
.groups b{color:var(--ink)}
.fields{display:flex;gap:8mm;margin:0 0 5mm;font-size:10.5pt}
.fields span{flex:1;border-bottom:1px solid var(--ink);padding-bottom:1mm}
.w3 td{height:12.5mm}
.remind{border-left:3px solid var(--terra);padding:1mm 0 1mm 3mm;font-size:9pt;color:var(--ink);margin:0 0 4mm}
.score{display:flex;gap:6mm;margin:0 0 5mm}
.score div{flex:1;border:1px solid var(--line);border-radius:3mm;padding:3mm 4mm;font-size:10pt}
.score div span{display:block;margin-top:5mm;border-bottom:1px solid var(--ink)}
.box.tall .lined{height:22mm}
@page{size:A4;margin:0}
@media print{
  body{background:#fff}
  .toolbar,.hint{display:none}
  .pages{padding:0;overflow:visible}
  .sheet{margin:0;box-shadow:none;break-after:page;page-break-after:always}
  .sheet:last-child{break-after:auto;page-break-after:auto}
}
</style>
</head>
<body>

<div class="toolbar"><div class="in">
