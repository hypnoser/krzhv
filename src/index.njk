        <dialog class="doc-dialog" id="docDialog" aria-label="Документ">
          <div class="doc-dialog-bar"><p id="docCap"></p><button type="button" class="doc-x" data-act="close" aria-label="Закрити">×</button></div>
          <div class="doc-dialog-body"><button type="button" class="doc-nav" data-act="prev" aria-label="Попередній">‹</button><img id="docImg" alt=""><button type="button" class="doc-nav" data-act="next" aria-label="Наступний">›</button></div>
        </dialog>
        <script type="application/json" id="docData">{{ dokumenty.main.concat(dokumenty.ptsr) | dump | safe }}</script>
        <script>
        (function () {
          var docs = JSON.parse(document.getElementById("docData").textContent), dlg = document.getElementById("docDialog");
          var img = document.getElementById("docImg"), cap = document.getElementById("docCap"), cur = 0;
          if (!dlg.showModal) return;
          function show(i) {
            cur = (i + docs.length) % docs.length;
            img.src = "/assets/images/dokumenty/" + docs[cur].file + ".webp";
            img.alt = docs[cur].title;
            cap.textContent = docs[cur].title + " — " + docs[cur].note;
          }
          document.querySelectorAll(".doc-thumb").forEach(function (b) {
            b.addEventListener("click", function () { show(+b.dataset.doc); dlg.showModal(); });
          });
          dlg.addEventListener("click", function (e) {
            var a = e.target.closest("[data-act]");
            if (a) { if (a.dataset.act === "close") dlg.close(); else show(cur + (a.dataset.act === "next" ? 1 : -1)); }
            else if (e.target === dlg) dlg.close();
          });
          dlg.addEventListener("keydown", function (e) {
            if (e.key === "ArrowRight") show(cur + 1);
            if (e.key === "ArrowLeft") show(cur - 1);
          });
        })();
        </script>
        <ul class="principles">
          <li><strong>Доказові методи</strong><span>Працюю лише з тим, що має підтвердження в дослідженнях.</span></li>
          <li><strong>Чесні межі</strong><span>Якщо ваш запит не мій, скажу прямо й підкажу, куди звернутися.</span></li>
          <li><strong>Конфіденційність</strong><span>Без вашої згоди про нашу роботу ніхто не дізнається.</span></li>
          <li><strong>Без зобов'язань</strong><span>Зупинитися можна будь-коли, без пояснень.</span></li>
        </ul>
       </div>
    </div>
  </div>
</section>

<section id="process" class="rm-section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Процес</span>
      <h2>Як виглядає терапія</h2>
      <p class="section-lead">П'ять кроків — від першого повідомлення до життя, де ви справляєтеся самі. Перший крок — найкоротший: одне повідомлення.</p>
    </div>

