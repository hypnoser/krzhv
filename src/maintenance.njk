      <path d="M38.5 21.5a7 7 0 0 0-8.6 9.3l-9 9a2.6 2.6 0 0 0 3.7 3.7l9-9a7 7 0 0 0 9.3-8.6l-4.2 4.2-3.6-.7-.7-3.6 4.1-4.3z" stroke="#C77A4F" stroke-width="2.2" stroke-linejoin="round" fill="#FDFDFB"/>
