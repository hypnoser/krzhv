<style>
@font-face{font-family:'Inter';src:url('/assets/fonts/Inter-400.woff2') format('woff2');font-weight:400;font-style:normal;font-display:swap;}
@font-face{font-family:'Inter';src:url('/assets/fonts/Inter-600.woff2') format('woff2');font-weight:600 700;font-style:normal;font-display:swap;}
@font-face{font-family:'Merriweather';src:url('/assets/fonts/Merriweather-300.woff2') format('woff2');font-weight:300;font-style:normal;font-display:swap;}
@font-face{font-family:'Merriweather';src:url('/assets/fonts/Merriweather-400.woff2') format('woff2');font-weight:400;font-style:normal;font-display:swap;}
:root{
  --accent:#3D5A4A;--accent-dark:#2C4437;--accent-tint:#E4EDE6;
  --terracotta:#C77A4F;--ink:#221F1B;--ink-soft:#5A5650;--ink-mute:#746A5F;
  --paper:#FCFAF6;--line:#E6E0D3;
  --serif:'Merriweather',Georgia,serif;--sans:'Inter',-apple-system,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%;}
body{
  font-family:var(--sans);color:var(--ink);background:var(--paper);line-height:1.6;
  -webkit-font-smoothing:antialiased;min-height:100vh;min-height:100dvh;
  display:flex;flex-direction:column;
}
.top{padding:28px 32px;}
.logo{font-family:var(--serif);font-size:20px;font-weight:400;color:var(--accent);display:block;line-height:1.2;}
.logo-sub{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-mute);display:block;margin-top:4px;}
main{flex:1;display:flex;align-items:center;justify-content:center;padding:32px 24px 72px;}
.box{max-width:520px;text-align:center;}
.eyebrow{
  display:inline-block;font-size:12px;letter-spacing:.08em;text-transform:uppercase;
  color:var(--accent);font-weight:600;background:var(--accent-tint);padding:6px 14px;border-radius:20px;
}
.mark{width:64px;height:64px;margin:28px auto 4px;display:block;}
h1{font-family:var(--serif);font-weight:300;font-size:36px;line-height:1.3;margin:16px 0 16px;color:var(--ink);}
p{font-size:16px;color:var(--ink-soft);line-height:1.7;}
.contact{
  margin-top:32px;padding:22px 24px;background:#fff;border:1px solid var(--line);border-radius:14px;
}
.contact .label{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-mute);font-weight:600;margin-bottom:8px;}
.contact a{
  font-size:20px;font-weight:600;color:var(--accent);text-decoration:none;
  border-bottom:2px solid var(--terracotta);padding-bottom:1px;word-break:break-all;
}
.contact a:hover,.contact a:focus-visible{color:var(--accent-dark);}
.urgent{margin-top:28px;font-size:14px;color:var(--ink-mute);line-height:1.65;}
a:focus-visible{outline:3px solid var(--terracotta);outline-offset:3px;border-radius:4px;}
@media (max-width:560px){
  .top{padding:22px 20px;}
  h1{font-size:28px;}
  .contact a{font-size:18px;}
}
</style>
</head>
<body>
<header class="top">
