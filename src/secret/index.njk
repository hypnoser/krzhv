---
layout: base.njk
permalink: /secret/
title: Закритий розділ
description: Закриті матеріали.
noindex: true
noAnalytics: true
eleventyExcludeFromCollections: true
---
{#
  /secret/ — вхід за паролем і список зашифрованих файлів із src/secret/files/.
  Як додати файл — README.md, розділ «Закритий розділ /secret/».
#}
<style>
.sec-card{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:28px;margin-bottom:24px;}
.sec-form{max-width:380px;}
.sec-form label,.sec-tool label{display:block;font-size:14px;color:var(--ink-soft);margin:14px 0 6px;}
.sec-form input,.sec-tool input,.sec-tool textarea{width:100%;font:inherit;font-size:16px;padding:11px 12px;border:1px solid var(--line);border-radius:6px;background:#fff;color:var(--ink);}
.sec-tool textarea{min-height:70px;resize:vertical;}
.sec-btn{background:var(--terracotta);color:#fff;border:0;border-radius:6px;padding:12px 26px;font:500 15px var(--sans);cursor:pointer;margin-top:16px;}
.sec-btn:hover{background:#B06A41;}
.sec-btn[disabled]{opacity:.6;cursor:wait;}
.sec-msg{min-height:1.4em;margin-top:12px;font-size:14px;color:var(--terracotta-text);}
.sec-list{display:grid;gap:16px;margin-bottom:40px;}
.sec-list .related-card h4{margin-bottom:8px;}
.sec-list .related-card p{font-size:15px;color:var(--ink-soft);line-height:1.6;}
.sec-empty{color:var(--ink-mute);}
.sec-group{background:var(--paper-alt);border-left:3px solid var(--accent);border-radius:12px;padding:28px;margin-bottom:32px;}
.sec-group-head{margin-bottom:20px;}
.sec-group-head h2{font-family:var(--serif);font-weight:400;font-size:26px;line-height:1.35;margin:10px 0 8px;color:var(--ink);}
.sec-group-head p{font-size:15px;color:var(--ink-soft);line-height:1.6;}
.sec-group .sec-list{grid-template-columns:repeat(2,minmax(0,1fr));margin-bottom:0;}
.sec-other-head{font-family:var(--serif);font-weight:400;font-size:22px;margin:0 0 16px;}
.sec-bar{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:24px;}
.sec-link{background:none;border:0;padding:0;font:inherit;font-size:14px;color:var(--ink-mute);text-decoration:underline;text-underline-offset:3px;cursor:pointer;}
.sec-tool summary{cursor:pointer;font-family:var(--serif);font-size:20px;}
.sec-tool ol{margin:16px 0 0 20px;color:var(--ink-soft);font-size:15px;line-height:1.7;}
.sec-tool code{background:var(--paper-alt);padding:1px 6px;border-radius:4px;font-size:14px;}
.sec-row{display:grid;grid-template-columns:1fr 160px;gap:12px;}
@media(max-width:860px){.sec-group .sec-list{grid-template-columns:1fr;}}
@media(max-width:560px){.sec-card,.sec-group{padding:20px;}.sec-row{grid-template-columns:1fr;}.sec-group-head h2{font-size:22px;}}
</style>

<div class="breadcrumb wrap">
  <a href="/">Головна</a><span>/</span>Закритий розділ
</div>

<section class="wrap page-head" style="padding-bottom:32px;">
  <span class="eyebrow">Закритий розділ</span>
  <h1>Робочі матеріали</h1>
  <p>Доступ лише за паролем.</p>
</section>

<div class="wrap">
  <div id="secLogin" class="sec-card" hidden>
    <form id="secForm" class="sec-form">
      <label for="secPw">Пароль</label>
      <input id="secPw" type="password" autocomplete="current-password" required>
      <button id="secBtn" class="sec-btn" type="submit">Увійти</button>
      <div id="secMsg" class="sec-msg" role="status"></div>
    </form>
  </div>

  <div id="secArea" hidden>
    <div class="sec-bar">
      <span class="eyebrow">Файли</span>
      <span><a class="sec-link" href="/secret/analytics/">Статистика відвідувань →</a> &nbsp; <button id="secOut" class="sec-link" type="button">Вийти на цьому пристрої</button></span>
    </div>
    <div id="secList"></div>

    <details class="sec-card sec-tool">
      <summary>Додати файл</summary>
      <form id="addForm">
        <label for="addFile">Файл .html або .md</label>
        <input id="addFile" type="file" accept=".html,.htm,.md,.markdown,text/html,text/markdown" required>
        <label for="addTitle">Назва в списку</label>
        <input id="addTitle" required>
        <label for="addDesc">Короткий опис</label>
        <textarea id="addDesc"></textarea>
        <label for="addGroup">Група (необов'язково)</label>
        <input id="addGroup" list="groupList" placeholder="Напр., Карти КПТ по сесіях">
        <datalist id="groupList"></datalist>
        <div class="sec-row">
          <div><label for="addName">Ім'я файлу (латиницею)</label><input id="addName" pattern="[a-z0-9-]+" required></div>
          <div><label for="addDate">Дата</label><input id="addDate" type="date" required></div>
        </div>
        <button id="addBtn" class="sec-btn" type="submit">Зашифрувати і завантажити</button>
        <div id="addMsg" class="sec-msg" role="status"></div>
      </form>
      <ol>
        <li>Браузер завантажить зашифрований файл, напр. <code>kpt-depresiia.html</code>. Шифрування відбувається тут, на пристрої — оригінал нікуди не надсилається.</li>
        <li>Відкрийте <a href="https://github.com/hypnoser/krzhv/upload/main/src/secret/files" target="_blank" rel="noopener">папку src/secret/files на GitHub</a>, перетягніть файл, натисніть <b>Commit changes</b>.</li>
        <li>За 1–2 хвилини файл з'явиться в списку. Оригінал у репозиторій не завантажуйте.</li>
      </ol>
    </details>
  </div>
</div>

<script type="application/json" id="secData">{{ secretFiles | dump | safe }}</script>
<script src="/assets/js/secret.js?v={{ build.version }}"></script>
{% raw %}
<script>
(function () {
  var S = window.KrzhvSecret, key = null;
  var $ = function (id) { return document.getElementById(id); };
  var files = JSON.parse($("secData").textContent);

  function esc(s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
  function ukDate(iso) {
    var d = new Date(iso + "T00:00:00");
    return isNaN(d) ? "" : d.toLocaleDateString("uk-UA", { day: "numeric", month: "long", year: "numeric" });
  }

  async function renderList() {
    var items = [];
    for (var i = 0; i < files.length; i++) {
      try { items.push(Object.assign({ url: files[i].url }, JSON.parse(await S.decrypt(key, files[i].meta)))); }
      catch (e) { items.push({ url: files[i].url, title: files[i].url.split("/").pop(), desc: "Не вдалося розшифрувати опис (інший пароль?)", date: "" }); }
    }
    items.sort(function (a, b) {
      return (b.date || "").localeCompare(a.date || "") || (a.order || 999) - (b.order || 999) || (a.title || "").localeCompare(b.title || "", "uk");
    });
    if (!items.length) { $("secList").innerHTML = '<p class="sec-empty">Поки що файлів немає.</p>'; return; }

    // Групування: групи — у порядку найновішого файлу; файли без групи — у кінці
    var groups = [], byName = {}, loose = [];
    items.forEach(function (it) {
      if (!it.group) { loose.push(it); return; }
      if (!byName[it.group]) { byName[it.group] = { name: it.group, desc: "", items: [] }; groups.push(byName[it.group]); }
      var g = byName[it.group];
      g.items.push(it);
      if (!g.desc && it.groupDesc) g.desc = it.groupDesc;
    });
    groups.forEach(function (g) { g.items.sort(function (a, b) { return (a.order || 999) - (b.order || 999) || (a.title || "").localeCompare(b.title || "", "uk"); }); });
    currentGroups = groups;
    $("groupList").innerHTML = groups.map(function (g) { return '<option value="' + esc(g.name) + '">'; }).join("");

    function card(it, inGroup) {
      var tag = (inGroup && it.order ? "№" + it.order + " · " : "") + ukDate(it.date) + (it.type ? " · " + it.type.toUpperCase() : "");
      return '<a class="related-card" href="' + esc(it.url) + '">' +
        '<span class="related-tag">' + esc(tag) + "</span>" +
        "<h4>" + esc(it.title) + "</h4>" + (it.desc ? "<p>" + esc(it.desc) + "</p>" : "") + "</a>";
    }
    function plural(n) {
      var m10 = n % 10, m100 = n % 100;
      return n + (m10 === 1 && m100 !== 11 ? " документ" : m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14) ? " документи" : " документів");
    }
    var html = groups.map(function (g) {
      return '<section class="sec-group"><div class="sec-group-head">' +
        '<span class="eyebrow">Група · ' + plural(g.items.length) + "</span>" +
        "<h2>" + esc(g.name) + "</h2>" + (g.desc ? "<p>" + esc(g.desc) + "</p>" : "") +
        '</div><div class="sec-list">' + g.items.map(function (it) { return card(it, true); }).join("") + "</div></section>";
    }).join("");
    if (loose.length) {
      html += (groups.length ? '<h2 class="sec-other-head">Інші файли</h2>' : "") +
        '<div class="sec-list">' + loose.map(function (it) { return card(it, false); }).join("") + "</div>";
    }
    $("secList").innerHTML = html;
  }
  var currentGroups = [];

  function enter(k) {
    key = k;
    $("secLogin").hidden = true;
    $("secArea").hidden = false;
    renderList();
  }

  $("secForm").addEventListener("submit", async function (e) {
    e.preventDefault();
    $("secBtn").disabled = true; $("secMsg").textContent = "Перевіряю…";
    var k = await S.login($("secPw").value);
    $("secBtn").disabled = false;
    if (k) { $("secMsg").textContent = ""; $("secPw").value = ""; enter(k); }
    else $("secMsg").textContent = "Невірний пароль";
  });

  $("secOut").addEventListener("click", function () {
    S.logout(); key = null;
    $("secArea").hidden = true; $("secList").innerHTML = ""; $("secLogin").hidden = false;
  });

  // ---- Додати файл ----
  var MAP = { "а":"a","б":"b","в":"v","г":"h","ґ":"g","д":"d","е":"e","є":"ie","ж":"zh","з":"z","и":"y","і":"i","ї":"i","й":"i","к":"k","л":"l","м":"m","н":"n","о":"o","п":"p","р":"r","с":"s","т":"t","у":"u","ф":"f","х":"kh","ц":"ts","ч":"ch","ш":"sh","щ":"shch","ь":"","ю":"iu","я":"ia","ё":"io","ы":"y","э":"e","ъ":"" };
  function slug(s) {
    return s.toLowerCase().split("").map(function (c) { return MAP[c] != null ? MAP[c] : c; }).join("")
      .replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").split("-").slice(0, 6).join("-");
  }
  var nameTouched = false;
  $("addDate").value = new Date().toISOString().slice(0, 10);
  $("addName").addEventListener("input", function () { nameTouched = true; });
  $("addTitle").addEventListener("input", function () { if (!nameTouched) $("addName").value = slug($("addTitle").value); });
  $("addFile").addEventListener("change", async function () {
    var f = this.files[0]; if (!f) return;
    if (!nameTouched) $("addName").value = slug(f.name.replace(/\.[^.]+$/, ""));
    if (!$("addTitle").value) {
      var t = await f.text();
      var m = t.match(/<title>([^<]*)<\/title>/i) || t.match(/^#\s+(.+)$/m) || t.match(/^title:\s*"?([^"\n]+)"?/m);
      if (m) $("addTitle").value = m[1].trim();
    }
  });

  function mdPage(title, body) {
    return '<!doctype html>\n<html lang="uk"><head><meta charset="utf-8">' +
      '<meta name="viewport" content="width=device-width, initial-scale=1"><title>' + esc(title) + "</title><style>" +
      "body{margin:0;background:#fff;color:#1d2127;font:16px/1.65 system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}" +
      "main{max-width:780px;margin:0 auto;padding:24px 16px 64px}h1,h2,h3{line-height:1.3}h2{margin-top:2em}" +
      "a{color:#2f5d8a}img{max-width:100%;height:auto}pre{background:#f4f4f1;padding:12px;overflow:auto;border-radius:6px}" +
      "code{background:#f4f4f1;padding:1px 4px;border-radius:3px}pre code{padding:0}blockquote{margin:0;padding-left:14px;border-left:3px solid #ddd;color:#555}" +
      "table{border-collapse:collapse;width:100%;display:block;overflow-x:auto}th,td{border:1px solid #ddd;padding:6px 8px;text-align:left}" +
      "@media (prefers-color-scheme:dark){body{background:#15181c;color:#e8eaed}a{color:#8db8e6}pre,code{background:#22272e}th,td{border-color:#2f353d}}" +
      "</style></head><body><main>" + body + "</main></body></html>";
  }

  $("addForm").addEventListener("submit", async function (e) {
    e.preventDefault();
    var f = $("addFile").files[0];
    $("addBtn").disabled = true; $("addMsg").textContent = "Шифрую…";
    try {
      var text = await f.text(), type = "html";
      if (/\.(md|markdown)$/i.test(f.name)) {
        type = "md";
        var marked = (await import("https://cdn.jsdelivr.net/npm/marked@15.0.12/lib/marked.esm.js")).marked;
        text = mdPage($("addTitle").value, marked.parse(text.replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n/, "")));
      }
      var meta = { title: $("addTitle").value.trim(), desc: $("addDesc").value.trim(), date: $("addDate").value, type: type };
      var grp = $("addGroup").value.trim();
      if (grp) {
        meta.group = grp;
        var g = currentGroups.filter(function (x) { return x.name === grp; })[0];
        if (g) meta.order = g.items.reduce(function (m, it) { return Math.max(m, it.order || 0); }, 0) + 1;
      }
      var out = await S.buildFile(key, meta, text);
      var a = document.createElement("a");
      a.href = URL.createObjectURL(new Blob([out], { type: "text/html" }));
      a.download = $("addName").value + ".html";
      document.body.appendChild(a); a.click(); a.remove();
      $("addMsg").textContent = "Готово: " + a.download + ". Тепер завантажте його на GitHub (крок 2).";
    } catch (err) {
      $("addMsg").textContent = "Помилка: " + err.message;
    }
    $("addBtn").disabled = false;
  });

  S.savedKey().then(function (k) { if (k) enter(k); else { $("secLogin").hidden = false; $("secPw").focus(); } });
})();
</script>
{% endraw %}
