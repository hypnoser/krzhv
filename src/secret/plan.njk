---
layout: base.njk
permalink: /secret/plan/
title: План публікацій
description: Закриті матеріали.
noindex: true
noAnalytics: true
eleventyExcludeFromCollections: true
---
{#
  /secret/plan/ — стаття й пости блогу, що публікуються в автоматичному режимі (чернетка листом, публікація на «ОК»).
  Список планових матеріалів — src/_data/contentPlan.json (лише дата, тип, заголовок, за потреби url).
  Статус «опубліковано» визначається під час відкриття сторінки за зібраними сторінками сайту.
  Вхід — той самий пароль, що й у /secret/.
#}
<style>
.pl-card{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:20px;}
.pl-login{max-width:420px;margin-bottom:24px;}
.pl-login label{display:block;font-size:14px;color:var(--ink-soft);margin:0 0 6px;}
.pl-login input{width:100%;font:inherit;font-size:16px;padding:11px 12px;border:1px solid var(--line);border-radius:6px;background:#fff;color:var(--ink);}
.pl-btn{background:var(--terracotta);color:#fff;border:0;border-radius:6px;padding:10px 20px;font:500 14px var(--sans);cursor:pointer;margin-top:14px;}
.pl-msg{min-height:1.4em;margin-top:10px;font-size:14px;color:var(--terracotta-text);}
.pl-bar{display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin-bottom:16px;}
.pl-bar .lbl{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-mute);margin-right:6px;}
.pl-seg{display:inline-flex;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:#fff;}
.pl-seg button{border:0;background:#fff;font:500 13px var(--sans);padding:8px 14px;cursor:pointer;color:var(--ink-soft);border-right:1px solid var(--line);}
.pl-seg button:last-child{border-right:0;}
.pl-seg button.on{background:var(--accent);color:#fff;}
.pl-seg button:not(.on):hover{background:var(--accent-tint);}
.pl-sum{font-size:14px;color:var(--ink-mute);margin:0 0 14px;}
.pl-list{display:grid;gap:10px;margin:0;padding:0;list-style:none;}
.pl-item{display:grid;grid-template-columns:130px 1fr auto;gap:6px 16px;align-items:center;background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:14px 18px;}
.pl-date{font-size:14px;color:var(--ink-soft);font-variant-numeric:tabular-nums;}
.pl-date small{display:block;color:var(--ink-mute);font-size:12px;}
.pl-title{font-size:16px;line-height:1.45;color:var(--ink);}
.pl-title a{color:var(--accent);text-underline-offset:3px;}
.pl-meta{font-size:12px;color:var(--ink-mute);margin-top:2px;}
.pl-st{font-size:12px;font-weight:600;padding:4px 10px;border-radius:999px;white-space:nowrap;}
.pl-st.pub{background:var(--accent-tint);color:var(--accent);}
.pl-st.plan{background:var(--sand-tint);color:var(--sand-text);}
.pl-st.late{background:var(--terracotta-tint);color:var(--terracotta-text);}
.pl-empty{color:var(--ink-mute);padding:20px 0;}
.pl-note{font-size:13px;line-height:1.55;color:var(--ink-mute);margin-top:20px;}
@media(max-width:640px){.pl-item{grid-template-columns:1fr auto;}.pl-date{grid-column:1 / -1;}}
</style>

<div class="breadcrumb wrap">
  <a href="/">Головна</a><span>/</span><a href="/secret/">Закритий розділ</a><span>/</span>План публікацій
</div>

<section class="wrap page-head" style="padding-bottom:24px;">
  <span class="eyebrow">Закритий розділ</span>
  <h1>План публікацій</h1>
  <p>Статті та пости блогу, що виходять в автоматичному режимі: чернетка надходить листом, публікація після «ОК».</p>
</section>

<div class="wrap" style="padding-bottom:48px;">
  <div id="plLogin" class="pl-card pl-login" hidden>
    <form id="plForm">
      <label for="plPw">Пароль</label>
      <input id="plPw" type="password" autocomplete="current-password" required>
      <button id="plBtn" class="pl-btn" type="submit">Увійти</button>
      <div id="plMsg" class="pl-msg" role="status"></div>
    </form>
  </div>

  <div id="plApp" hidden>
    <div class="pl-bar">
      <div><span class="lbl">Статус</span><span class="pl-seg" id="plStatus">
        <button type="button" data-s="todo" class="on">Не опубліковані</button>
        <button type="button" data-s="done">Опубліковані</button>
        <button type="button" data-s="all">Усі</button></span></div>
      <div><span class="lbl">Тип</span><span class="pl-seg" id="plType">
        <button type="button" data-t="all" class="on">Усі</button>
        <button type="button" data-t="article">Статті</button>
        <button type="button" data-t="blog">Блог</button></span></div>
      <a class="sec-link" href="/secret/" style="font-size:14px;color:var(--ink-mute);">← Закритий розділ</a>
    </div>
    <p class="pl-sum" id="plSum"></p>
    <ul class="pl-list" id="plList"></ul>
    <p class="pl-note">Слоти: статті середа й неділя, блог понеділок («Для колег») і п'ятниця («Журнал»). «Опубліковано» означає, що сторінка вже є на сайті; «Дата минула» — чернетка ще чекає на «ОК» або вийшла іншого дня (тоді в списку має бути уточнено адресу). Список матеріалів: <code>src/_data/contentPlan.json</code>.</p>
  </div>
</div>

<script type="application/json" id="plPlan">{{ contentPlan | dump | safe }}</script>
<script type="application/json" id="plPages">[{% set first = true %}{% for p in collections.all %}{% if p.url and p.data.title and ((p.url.indexOf('/statti/') === 0 and p.url != '/statti/') or (p.url.indexOf('/blog/') === 0 and p.url != '/blog/')) %}{% if not first %},{% endif %}{% set first = false %}{{ { url: p.url, type: ('article' if p.url.indexOf('/statti/') === 0 else 'blog'), date: (p.data.date | isoDate), title: p.data.title } | dump | safe }}{% endif %}{% endfor %}]</script>
<script src="/assets/js/secret.js?v={{ build.version }}"></script>
{% raw %}
<script>
(function () {
  var K = window.KrzhvSecret, $ = function (id) { return document.getElementById(id); };
  var plan = JSON.parse($("plPlan").textContent), pages = JSON.parse($("plPages").textContent);
  var st = { s: "todo", t: "all" };
  var MON = ["січня", "лютого", "березня", "квітня", "травня", "червня", "липня", "серпня", "вересня", "жовтня", "листопада", "грудня"];
  var WD = ["неділя", "понеділок", "вівторок", "середа", "четвер", "п'ятниця", "субота"];
  var AUD = { journal: "Журнал", colleagues: "Для колег" };

  function esc(s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
  function today() { return new Intl.DateTimeFormat("sv-SE", { timeZone: "Europe/Kyiv" }).format(new Date()); }
  function dateLabel(iso) {
    var p = iso.split("-"), d = new Date(Date.UTC(+p[0], +p[1] - 1, +p[2]));
    return { d: +p[2] + " " + MON[+p[1] - 1] + " " + p[0], w: WD[d.getUTCDay()] };
  }

  // Опубліковано: є сторінка за вказаною адресою, а без адреси — сторінка того ж типу з тією ж датою
  function classify(it, now) {
    var pub = it.url ? pages.some(function (p) { return p.url === it.url; })
      : pages.some(function (p) { return p.type === it.type && p.date === it.date; });
    if (pub) return "pub";
    return it.date < now ? "late" : "plan";
  }

  function render() {
    var now = today();
    var rows = plan.map(function (it) { return Object.assign({ st: classify(it, now) }, it); })
      .filter(function (r) { return st.t === "all" || r.type === st.t; });
    var counts = { todo: 0, done: 0 };
    rows.forEach(function (r) { counts[r.st === "pub" ? "done" : "todo"]++; });
    var shown = rows.filter(function (r) { return st.s === "all" || (st.s === "done") === (r.st === "pub"); });
    shown.sort(function (a, b) {
      var ap = a.st === "pub", bp = b.st === "pub";
      if (ap !== bp) return ap ? 1 : -1;
      return ap ? b.date.localeCompare(a.date) : a.date.localeCompare(b.date);
    });
    $("plSum").textContent = "Не опубліковано: " + counts.todo + " · Опубліковано: " + counts.done + " · Показано: " + shown.length;
    $("plList").innerHTML = shown.length ? shown.map(function (r) {
      var dl = dateLabel(r.date), label = r.st === "pub" ? "Опубліковано" : r.st === "late" ? "Дата минула" : "В плані";
      var title = r.st === "pub" && r.url ? '<a href="' + esc(r.url) + '">' + esc(r.title) + "</a>" : esc(r.title);
      var meta = (r.type === "article" ? "Стаття" : "Блог" + (r.audience ? " · " + AUD[r.audience] : ""));
      return '<li class="pl-item"><div class="pl-date">' + dl.d + "<small>" + dl.w + '</small></div><div><div class="pl-title">' + title +
        '</div><div class="pl-meta">' + meta + '</div></div><span class="pl-st ' + r.st + '">' + label + "</span></li>";
    }).join("") : '<li class="pl-empty">Тут поки нічого немає.</li>';
    [["plStatus", "s"], ["plType", "t"]].forEach(function (g) {
      Array.prototype.forEach.call($(g[0]).children, function (b) { b.classList.toggle("on", b.getAttribute("data-" + g[1]) === st[g[1]]); });
    });
  }

  function start() {
    $("plLogin").hidden = true; $("plApp").hidden = false;
    [["plStatus", "s"], ["plType", "t"]].forEach(function (g) {
      $(g[0]).addEventListener("click", function (e) {
        var v = e.target.getAttribute && e.target.getAttribute("data-" + g[1]);
        if (v) { st[g[1]] = v; render(); }
      });
    });
    render();
  }

  $("plForm").addEventListener("submit", async function (ev) {
    ev.preventDefault();
    var btn = $("plBtn"), msg = $("plMsg");
    btn.disabled = true; msg.textContent = "Перевіряю…";
    try {
      var key = await K.login($("plPw").value);
      if (!key) { msg.textContent = "Невірний пароль"; btn.disabled = false; return; }
      start();
    } catch (e) { msg.textContent = "Помилка: " + e.message; btn.disabled = false; }
  });
  K.savedKey().then(function (key) { if (key) start(); else { $("plLogin").hidden = false; $("plPw").focus(); } });
  window.__plan = { classify: classify };
})();
</script>
{% endraw %}
