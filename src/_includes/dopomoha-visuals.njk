{#
  Наочні підказки для /dopomoha/. Кольори — класами з dopomoha.css (v-acc, v-ter, v-mute…),
  тож схеми узгоджені з палітрою сайту. Кожна схема має текстовий опис (role="img" + aria-label).
#}

{%- macro icon(key, cls="dh-ic") -%}
<svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- if key == "yes" -%}<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.7 2.7L16.5 9.5"/>
{%- elif key == "no" -%}<circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/>
{%- elif key == "unsure" -%}<circle cx="12" cy="12" r="9"/><path d="M9.6 9.4a2.5 2.5 0 0 1 4.8.9c0 1.7-2.4 2-2.4 3.7M12 17h.01"/>
{%- elif key == "alert" -%}<path d="M12 3.5l9.5 16.5h-19z"/><path d="M12 10v4.5M12 17.5h.01"/>
{%- elif key == "check" -%}<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"/><path d="M12 14.5v2"/>
{%- elif key == "ask" -%}<path d="M4 5.5h11a2 2 0 0 1 2 2V13a2 2 0 0 1-2 2H9l-4 3v-3H4a2 2 0 0 1-2-2V7.5a2 2 0 0 1 2-2z"/><path d="M19.5 9.5H20a2 2 0 0 1 2 2V16a2 2 0 0 1-2 2h-.5v2.5l-3-2.5"/>
{%- elif key == "search" -%}<circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l5.5 5.5"/>
{%- elif key == "water" -%}<path d="M6.5 4h11l-1.4 15.2a1.5 1.5 0 0 1-1.5 1.3H9.4a1.5 1.5 0 0 1-1.5-1.3z"/><path d="M7.3 10.5h9.4"/>
{%- elif key == "window" -%}<rect x="4" y="3.5" width="16" height="17" rx="1.5"/><path d="M12 3.5v17M4 12h16"/><path d="M15.5 6.5l2 2"/>
{%- elif key == "box" -%}<path d="M4 8l8-4 8 4v8.5l-8 4-8-4z"/><path d="M4 8l8 4 8-4M12 12v8.5"/>
{%- elif key == "chat" -%}<path d="M5 5h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8l-5 3.5V17H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"/><path d="M7.5 10h9M7.5 13h5"/>
{%- elif key == "doc" -%}<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 15.5h6"/>
{%- elif key == "seat" -%}<path d="M7 4v9h10"/><path d="M7 13l-1.5 7M17 13l1.5 7M9 13v-2.5h8V13"/>
{%- elif key == "music" -%}<path d="M9 18V6l11-2v12"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="17.5" cy="16" r="2.5"/>
{%- elif key == "pause" -%}<circle cx="12" cy="12" r="9"/><path d="M10 9v6M14 9v6"/>
{%- elif key == "feet" -%}<path d="M7.5 3.5c1.7 0 2.5 2 2.5 4.5s-.6 5-2.3 5-2.7-2.2-2.7-4.7 1-4.8 2.5-4.8zM16.5 6.5c1.5 0 2.5 2.3 2.5 4.8s-1 4.7-2.7 4.7-2.3-2.5-2.3-5 .8-4.5 2.5-4.5z"/><path d="M5.5 16.5c.3 1.6 1.2 2.5 2.2 2.5s1.8-.9 2-2.5M14.3 19.5c.2 1.2 1 2 2 2s1.9-.8 2.2-2"/>
{%- elif key == "eye" -%}<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/>
{%- elif key == "clock" -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{%- elif key == "phone" -%}<path d="M5 3.5h3.5l1.5 4-2 1.5a11 11 0 0 0 7 7l1.5-2 4 1.5V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.1 1.5 1.5 0 0 1 5 3.5z"/>
{%- else -%}<circle cx="12" cy="12" r="9"/>
{%- endif -%}
</svg>
{%- endmacro -%}

{%- macro cycleSvg(second, uid) -%}
<svg class="dh-vis-svg" viewBox="0 0 320 210" role="img" aria-label="Коло: сумнів → {{ second }} → полегшення ненадовго → сумнів повертається → і знову {{ second | lower }}.">
  <defs><marker id="dh-arr-{{ uid }}" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" class="v-fill-mute"/></marker></defs>
  <path d="M160 34 A92 76 0 0 1 262 105" class="v-arc" marker-end="url(#dh-arr-{{ uid }})"/>
  <path d="M262 112 A92 76 0 0 1 160 182" class="v-arc" marker-end="url(#dh-arr-{{ uid }})"/>
  <path d="M152 182 A92 76 0 0 1 58 112" class="v-arc" marker-end="url(#dh-arr-{{ uid }})"/>
  <path d="M58 104 A92 76 0 0 1 150 34" class="v-arc" marker-end="url(#dh-arr-{{ uid }})"/>
  <rect x="104" y="12" width="112" height="34" rx="17" class="v-box-ter"/><text x="160" y="34" class="v-t">Сумнів</text>
  <rect x="214" y="90" width="100" height="34" rx="17" class="v-box"/><text x="264" y="112" class="v-t">{{ second }}</text>
  <rect x="88" y="166" width="144" height="36" rx="18" class="v-box-acc"/><text x="160" y="182" class="v-t v-t-s">Полегшення</text><text x="160" y="196" class="v-t v-t-s">ненадовго</text>
  <rect x="6" y="90" width="104" height="34" rx="17" class="v-box"/><text x="58" y="104" class="v-t v-t-s">Сумнів</text><text x="58" y="117" class="v-t v-t-s">повертається</text>
  <text x="160" y="110" class="v-t v-t-big">↻</text>
</svg>
{%- endmacro -%}

{%- macro visual(key, uid="") -%}
{%- if key == "thought" -%}
<div class="dh-vis">
<svg class="dh-vis-svg dh-vis-sm" viewBox="0 0 240 110" role="img" aria-label="Хмарка думки з одним коротким реченням усередині.">
  <path d="M60 78c-22 0-34-12-34-26s14-26 32-25c6-14 20-21 36-19 10-10 32-11 44 0 18-4 36 4 40 20 18 2 30 13 30 27s-14 24-34 23c-8 9-24 13-38 8-12 8-34 8-46 0-12 4-24 2-30-8z" class="v-cloud"/>
  <rect x="64" y="46" width="112" height="9" rx="4.5" class="v-fill-ter"/>
  <circle cx="44" cy="94" r="6" class="v-cloud"/><circle cx="30" cy="104" r="3.5" class="v-cloud"/>
</svg>
</div>
{%- elif key == "fork" -%}
<div class="dh-vis">
<svg class="dh-vis-svg" viewBox="0 0 320 170" role="img" aria-label="Схема: думка → чи можу щось зробити? Якщо так — один маленький крок. Якщо ні — повернутися до своєї справи.">
  <rect x="110" y="6" width="100" height="32" rx="16" class="v-box"/><text x="160" y="27" class="v-t">Думка</text>
  <path d="M160 38v14" class="v-line"/>
  <path d="M160 52l58 24-58 24-58-24z" class="v-box-ter"/><text x="160" y="73" class="v-t v-t-s">Можу щось</text><text x="160" y="87" class="v-t v-t-s">зробити?</text>
  <path d="M102 76H58v46M218 76h44v46" class="v-line"/>
  <text x="80" y="70" class="v-t v-t-s v-t-acc">так</text><text x="240" y="70" class="v-t v-t-s v-t-ter">ні</text>
  <rect x="6" y="122" width="104" height="40" rx="12" class="v-box-acc"/><text x="58" y="139" class="v-t v-t-s">Один</text><text x="58" y="153" class="v-t v-t-s">маленький крок</text>
  <rect x="200" y="122" width="114" height="40" rx="12" class="v-box"/><text x="257" y="139" class="v-t v-t-s">Повернутися</text><text x="257" y="153" class="v-t v-t-s">до своєї справи</text>
</svg>
</div>
{%- elif key == "step" -%}
<div class="dh-vis">
<svg class="dh-vis-svg dh-vis-sm" viewBox="0 0 240 100" role="img" aria-label="Сходинки: виділена лише перша, найнижча — її достатньо.">
  <path d="M20 88h50V68h50V48h50V28h50" class="v-line v-line-thick"/>
  <rect x="20" y="70" width="50" height="18" rx="3" class="v-fill-acc"/>
  <text x="45" y="62" class="v-t v-t-s v-t-acc">ось цей</text>
</svg>
</div>
{%- elif key == "letgo" -%}
<div class="dh-vis">
<svg class="dh-vis-svg dh-vis-sm" viewBox="0 0 240 110" role="img" aria-label="Думка «а раптом» відпливає хмаркою, а ви тримаєте в руках чашку — свою справу.">
  <path d="M138 44c-10 0-16-6-16-13s7-13 16-12c4-8 12-11 20-9 7-5 18-4 22 2 10-1 18 5 18 13s-8 14-18 13c-6 6-18 7-26 2-6 4-14 4-16 4z" class="v-cloud v-dashed"/>
  <text x="160" y="35" class="v-t v-t-s v-t-mute">а раптом…</text>
  <path d="M112 50l-14 12" class="v-line v-dashed"/>
  <path d="M44 62h44v24a12 12 0 0 1-12 12H56a12 12 0 0 1-12-12z" class="v-box-acc"/>
  <path d="M88 68h6a7 7 0 0 1 0 14h-6" class="v-line"/>
  <path d="M56 54c0-5 4-5 4-10M70 54c0-5 4-5 4-10" class="v-line v-line-mute"/>
</svg>
</div>
{%- elif key == "clock" -%}
<div class="dh-vis">
<svg class="dh-vis-svg dh-vis-sm" viewBox="0 0 240 100" role="img" aria-label="Годинник: хвилюванню відведено короткий час пізніше, наприклад о 18:00.">
  <circle cx="70" cy="50" r="38" class="v-box"/>
  <path d="M70 50L70 22" class="v-line v-line-thick"/><path d="M70 50L70 76" class="v-line"/>
  <path d="M70 12A38 38 0 0 1 99 25L70 50z" class="v-fill-ter v-op"/>
  <text x="168" y="46" class="v-t v-t-big2">18:00</text><text x="168" y="68" class="v-t v-t-s v-t-mute">10–15 хвилин</text>
</svg>
</div>
{%- elif key == "cycle" -%}
<div class="dh-vis">{{ cycleSvg("Перевірка", uid) }}</div>
{%- elif key == "cycle-ask" -%}
<div class="dh-vis">{{ cycleSvg("Перепитати", uid) }}</div>
{%- elif key == "cycle-search" -%}
<div class="dh-vis">{{ cycleSvg("Пошук", uid) }}</div>
{%- elif key == "timer" -%}
<div class="dh-vis dh-timer" data-timer="300">
  <svg class="dh-vis-svg dh-timer-svg" viewBox="0 0 120 120" aria-hidden="true">
    <circle cx="60" cy="60" r="52" class="dh-timer-track"/>
    <circle cx="60" cy="60" r="52" class="dh-timer-bar" pathLength="100" transform="rotate(-90 60 60)"/>
  </svg>
  <p class="dh-timer-time" aria-hidden="true">5:00</p>
  <p class="dh-timer-label">5 хвилин</p>
  <button type="button" class="dh-btn dh-btn-secondary dh-timer-btn" data-timer-start hidden>Запустити таймер</button>
  <p class="dh-timer-done" role="status" hidden></p>
</div>
{%- elif key == "breath" -%}
<div class="dh-vis dh-breath" data-breath>
  <div class="dh-breath-stage" aria-hidden="true">
    <div class="dh-breath-circle"></div>
    <p class="dh-breath-word">Вдих</p>
  </div>
  <p class="dh-small dh-breath-hint">Приблизно 5 секунд на вдих і 5 на видих. Без звуку.</p>
  <button type="button" class="dh-btn dh-btn-secondary" data-breath-toggle hidden>Почати</button>
</div>
{%- elif key == "wave" -%}
<div class="dh-vis">
<svg class="dh-vis-svg" viewBox="0 0 320 130" role="img" aria-label="Хвиля: відчуття наростають, досягають піку і спадають.">
  <path d="M8 112C70 112 92 20 160 20S250 112 312 112" class="v-wave"/>
  <path d="M8 112C70 112 92 20 160 20S250 112 312 112V122H8z" class="v-fill-acc v-op"/>
  <text x="104" y="104" class="v-t v-t-s">наростає ↗</text>
  <text x="160" y="12" class="v-t v-t-s">пік</text>
  <text x="216" y="104" class="v-t v-t-s v-t-acc">↘ спадає</text>
</svg>
</div>
{%- elif key and key.startsWith("icon-") -%}
<div class="dh-vis dh-vis-icon" aria-hidden="true">{{ icon(key.slice(5), "dh-bigicon") }}</div>
{%- endif -%}
{%- endmacro -%}
