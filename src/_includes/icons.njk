{% macro categoryIcon(name) %}
{%- if name == "Тривожні розлади" or name == "Тривога" -%}
<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12.5h4l2-5 3 9 2.5-6 1.5 3h7"/></svg>
{%- elif name == "Настрій" or name == "Депресія" -%}
<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 16a4 4 0 0 1 .3-8 5 5 0 0 1 9.6-1.4A4.2 4.2 0 0 1 17.5 16h-11z"/><path d="M8 19.5v.01M12 19.5v.01M16 19.5v.01"/></svg>
{%- elif name == "ОКР" -%}
