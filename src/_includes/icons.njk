{%- elif name == "Тіло і стрес" -%}
<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c2.8 3.6 4.4 6.3 4.4 9a4.4 4.4 0 1 1-8.8 0c0-1 .3-1.9.8-2.8.4.8 1 1.3 1.7 1.3.9 0 1.4-.8 1.2-1.8-.3-1.6-.2-3.3.7-5.7z"/></svg>
