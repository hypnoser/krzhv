<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}{% if title != "Сергій Коржов — Клінічний психолог, КПТ онлайн" %} — Сергій Коржов{% endif %}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="https://krzhv.pp.ua{{ page.url }}">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#3D5A4A">

{# Open Graph / social preview #}
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:url" content="https://krzhv.pp.ua{{ page.url }}">
<meta property="og:locale" content="uk_UA">
<meta property="og:image" content="https://krzhv.pp.ua/assets/images/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:site_name" content="Сергій Коржов — Клінічний психолог">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="https://krzhv.pp.ua/assets/images/og-image.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">

{# Google tag (gtag.js) #}
<script async src="https://www.googletagmanager.com/gtag/js?id=G-EC6CST6KSZ"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-EC6CST6KSZ');
</script>

{% if schema %}
<script type="application/ld+json">{{ schema | dump | safe }}</script>
{% endif %}
</head>
<body>

<header>
  <div class="nav">
    <a href="/" class="logo-block">
      <span class="logo">Сергій Коржов</span>
      <span class="logo-subtitle">Клінічний психолог</span>
    </a>
    <nav class="nav-links">
      <a href="/statti/" {% if section == 'statti' %}class="active"{% endif %}><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5C4 4.7 4.7 4 5.5 4H12v16H5.5A1.5 1.5 0 0 1 4 18.5v-13z"/><path d="M20 5.5c0-.8-.7-1.5-1.5-1.5H12v16h6.5a1.5 1.5 0 0 0 1.5-1.5v-13z"/></svg>Матеріали</a>
      <a href="/blog/" {% if section == 'blog' %}class="active"{% endif %}><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l1.2-4.3L16.4 4.5a1.7 1.7 0 0 1 2.4 0l.7.7a1.7 1.7 0 0 1 0 2.4L8.3 18.8 4 20z"/><path d="M14.5 6.5l3 3"/></svg>Блог</a>
      <a href="/vidguky/" {% if section == 'vidguky' %}class="active"{% endif %}><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5l2.5 5.4 5.8.6-4.4 4 1.2 5.8L12 16.3l-5.1 3 1.2-5.8-4.4-4 5.8-.6z"/></svg>Відгуки</a>
      <a href="/#about"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.4"/><path d="M5 20c1-4 3.5-6 7-6s6 2 7 6"/></svg>Про мене</a>
    </nav>
    <a href="/#contact" class="nav-cta">Записатись</a>
    <button class="nav-toggle" id="navToggle" aria-label="Відкрити меню" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>
  <nav class="nav-links-mobile" id="navMobile">
    <a href="/statti/" {% if section == 'statti' %}class="active"{% endif %}><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5C4 4.7 4.7 4 5.5 4H12v16H5.5A1.5 1.5 0 0 1 4 18.5v-13z"/><path d="M20 5.5c0-.8-.7-1.5-1.5-1.5H12v16h6.5a1.5 1.5 0 0 0 1.5-1.5v-13z"/></svg>Матеріали</a>
    <a href="/blog/" {% if section == 'blog' %}class="active"{% endif %}><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l1.2-4.3L16.4 4.5a1.7 1.7 0 0 1 2.4 0l.7.7a1.7 1.7 0 0 1 0 2.4L8.3 18.8 4 20z"/><path d="M14.5 6.5l3 3"/></svg>Блог</a>
    <a href="/vidguky/" {% if section == 'vidguky' %}class="active"{% endif %}><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5l2.5 5.4 5.8.6-4.4 4 1.2 5.8L12 16.3l-5.1 3 1.2-5.8-4.4-4 5.8-.6z"/></svg>Відгуки</a>
    <a href="/#about"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.4"/><path d="M5 20c1-4 3.5-6 7-6s6 2 7 6"/></svg>Про мене</a>
  </nav>
</header>

<script>
  var navToggle = document.getElementById('navToggle');
  var navMobile = document.getElementById('navMobile');
  navToggle.addEventListener('click', function () {
    var isOpen = navMobile.classList.toggle('open');
    navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });
</script>

<main>
{{ content | safe }}
</main>

<footer>
  <p>Сергій Коржов · © {{ currentYear }} · Клінічний психолог · КПТ</p>
</footer>

</body>
</html>
