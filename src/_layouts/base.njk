  <div class="footer-grid">
    <div class="footer-brand">
      <a href="/" class="logo-block">
        <span class="logo">Сергій Коржов</span>
        <span class="logo-subtitle">Клінічний психолог</span>
      </a>
      <p>КПТ · Онлайн · Весь світ</p>
    </div>
    <nav class="footer-col" aria-labelledby="footer-site">
      <h2 id="footer-site">Сайт</h2>
      <ul>
        <li><a href="/statti/">Матеріали</a></li>
        <li><a href="/blog/">Блог</a></li>
        <li><a href="/kviz/">Опитувальники</a></li>
