<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
{#- Виключення власника зі статистики Cloudflare Web Analytics: у браузері з прапорцем krzhv-noanalytics
    (ставиться після входу в /secret/ або за посиланням ?noanalytics=1; ?noanalytics=0 — вмикає облік назад; без прапорця, але з входом у /secret/ — теж не рахується)
    маяк завантажується як завжди, але його звіти (/cdn-cgi/rum) не відправляються. -#}
<script>(function(){try{var k="krzhv-noanalytics",q=location.search,ls=localStorage;if(/[?&]noanalytics=1\b/.test(q))ls.setItem(k,"1");if(/[?&]noanalytics=0\b/.test(q))ls.setItem(k,"0");var v=ls.getItem(k);if(!(v==="1"||(v===null&&ls.getItem("krzhv-secret-key-v1"))))return;var r=/\/cdn-cgi\/rum|cloudflareinsights\.com\/cdn-cgi/,n=navigator,sb=n.sendBeacon&&n.sendBeacon.bind(n);if(sb)n.sendBeacon=function(u,d){return r.test(String(u))?true:sb(u,d)};var f=window.fetch;if(f)window.fetch=function(i,o){var u=typeof i==="string"?i:(i&&i.url)||"";return r.test(String(u))?Promise.resolve(new Response(null,{status:204})):f.apply(this,arguments)};var X=XMLHttpRequest.prototype,op=X.open,sd=X.send;X.open=function(m,u){this.__noa=r.test(String(u));return op.apply(this,arguments)};X.send=function(){if(!this.__noa)return sd.apply(this,arguments)}}catch(e){}})();</script>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% set docTitle = seoTitle or title %}<title>{{ docTitle }}{% if docTitle != "Сергій Коржов — Клінічний психолог, КПТ онлайн" %} — Сергій Коржов{% endif %}</title>
<meta name="description" content="{{ description }}">
<meta name="author" content="Сергій Коржов">
<meta name="referrer" content="strict-origin-when-cross-origin">
{% if noindex %}<meta name="robots" content="noindex, follow">{% else %}<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">{% endif %}
{% set ogImg = "https://krzhv.com.ua" + (ogImage or "/assets/images/og-image.jpg") %}
<link rel="canonical" href="https://krzhv.com.ua{{ page.url }}">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="alternate" type="application/atom+xml" title="Сергій Коржов — статті та блог" href="/feed.xml">
<meta name="theme-color" content="#3D5A4A">

{# Open Graph / social preview #}
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:url" content="https://krzhv.com.ua{{ page.url }}">
<meta property="og:locale" content="uk_UA">
<meta property="og:image" content="{{ ogImg }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{% if ogImageAlt %}<meta property="og:image:alt" content="{{ ogImageAlt }}">{% endif %}
<meta property="og:site_name" content="Сергій Коржов — Клінічний психолог">
{% if ogType == 'article' %}
<meta property="article:published_time" content="{{ date | isoDate }}">
<meta property="article:modified_time" content="{{ (updated or date) | isoDate }}">
<meta property="article:author" content="https://krzhv.com.ua/#about">
<meta property="article:section" content="{{ category or sectionLabel }}">
{% for t in seoTags %}<meta property="article:tag" content="{{ t }}">
{% endfor %}{% endif %}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ ogImg }}">
{% if ogImageAlt %}<meta name="twitter:image:alt" content="{{ ogImageAlt }}">{% endif %}

{# Наперед — лише шрифти першого екрана: основний текст і заголовок. Решта підвантажується за потреби. #}
<link rel="preload" href="/assets/fonts/Inter-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/Merriweather-300.woff2" as="font" type="font/woff2" crossorigin>
{% if siteStatus.closed and not isSecretPage %}<script>try{if(localStorage.getItem("krzhv_maintenance_bypass")==="1")document.documentElement.className+=" mnt-open"}catch(e){}</script>
{% endif %}
<style>{{ inlineCss | safe }}</style>
{% for href in pageStyles %}<link rel="stylesheet" href="{{ href }}?v={{ build.version }}">
{% endfor %}


{% if schema %}
<script type="application/ld+json">{{ schema | dump | safe }}</script>
{% endif %}
</head>
<body>
<a href="#main" class="skip-link">Перейти до змісту</a>

<header class="site-header">
  <div class="nav">
    <a href="/" class="logo-block">
      <span class="logo">Сергій Коржов</span>
      <span class="logo-subtitle">Клінічний психолог</span>
    </a>
    <nav class="nav-links" aria-label="Основне меню">
      <a href="/statti/" {% if section == 'statti' %}class="active"{% endif %}><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5C4 4.7 4.7 4 5.5 4H12v16H5.5A1.5 1.5 0 0 1 4 18.5v-13z"/><path d="M20 5.5c0-.8-.7-1.5-1.5-1.5H12v16h6.5a1.5 1.5 0 0 0 1.5-1.5v-13z"/></svg>Матеріали</a>
      <a href="/blog/" {% if section == 'blog' %}class="active"{% endif %}><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l1.2-4.3L16.4 4.5a1.7 1.7 0 0 1 2.4 0l.7.7a1.7 1.7 0 0 1 0 2.4L8.3 18.8 4 20z"/><path d="M14.5 6.5l3 3"/></svg>Блог</a>
      <a href="/kviz/" {% if section == 'kviz' %}class="active"{% endif %}><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3.5" width="14" height="17" rx="2"/><path d="M9 8.5h6M9 12.5h6M9 16.5h3.5"/></svg>Опитувальники</a>
      <a href="/#about"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.4"/><path d="M5 20c1-4 3.5-6 7-6s6 2 7 6"/></svg>Про мене</a>
    </nav>
    <a href="/#contact" class="nav-cta">Записатись</a>
    <button type="button" class="nav-toggle" id="navToggle" aria-label="Відкрити меню" aria-expanded="false" aria-controls="navMobile">
      <svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <nav class="nav-links-mobile" id="navMobile" aria-label="Мобільне меню">
    <a href="/statti/" {% if section == 'statti' %}class="active"{% endif %}><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5C4 4.7 4.7 4 5.5 4H12v16H5.5A1.5 1.5 0 0 1 4 18.5v-13z"/><path d="M20 5.5c0-.8-.7-1.5-1.5-1.5H12v16h6.5a1.5 1.5 0 0 0 1.5-1.5v-13z"/></svg>Матеріали</a>
    <a href="/blog/" {% if section == 'blog' %}class="active"{% endif %}><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l1.2-4.3L16.4 4.5a1.7 1.7 0 0 1 2.4 0l.7.7a1.7 1.7 0 0 1 0 2.4L8.3 18.8 4 20z"/><path d="M14.5 6.5l3 3"/></svg>Блог</a>
    <a href="/kviz/" {% if section == 'kviz' %}class="active"{% endif %}><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3.5" width="14" height="17" rx="2"/><path d="M9 8.5h6M9 12.5h6M9 16.5h3.5"/></svg>Опитувальники</a>
    <a href="/#about"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.4"/><path d="M5 20c1-4 3.5-6 7-6s6 2 7 6"/></svg>Про мене</a>
    <a href="/help/" class="nav-help">Термінова допомога</a>
  </nav>
</header>

<div class="site-notice" role="note">Прийом нових клієнтів на психотерапію тимчасово призупинено.</div>

<script>
  (function () {
    var header = document.querySelector('.site-header');
    var toggle = document.getElementById('navToggle');
    var menu = document.getElementById('navMobile');
    function setOpen(open) {
      menu.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Закрити меню' : 'Відкрити меню');
      if (open) header.classList.remove('header-hidden');
    }
    function isOpen() { return menu.classList.contains('open'); }
    toggle.addEventListener('click', function () { setOpen(!isOpen()); });
    menu.addEventListener('click', function (e) { if (e.target.closest('a')) setOpen(false); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isOpen()) { setOpen(false); toggle.focus(); }
    });
    document.addEventListener('click', function (e) {
      if (isOpen() && !header.contains(e.target)) setOpen(false);
    });
    window.addEventListener('resize', function () { if (window.innerWidth > 860 && isOpen()) setOpen(false); });

    // Низький екран (телефон горизонтально): шапка ховається при прокрутці вниз і повертається при прокрутці вгору
    var lastY = window.scrollY;
    window.addEventListener('scroll', function () {
      var y = window.scrollY;
      var low = window.innerHeight < 520;
      if (!low || isOpen() || header.contains(document.activeElement) || y < 120) {
        header.classList.remove('header-hidden');
      } else if (y > lastY + 6) {
        header.classList.add('header-hidden');
      } else if (y < lastY - 6) {
        header.classList.remove('header-hidden');
      }
      lastY = y;
    }, { passive: true });
    header.addEventListener('focusin', function () { header.classList.remove('header-hidden'); });
  })();
</script>

<main id="main" tabindex="-1">
{{ content | safe }}
</main>

{# Накладка «сайт закрито»: вмикається прапорцем closed у src/_data/siteStatus.json. Не показується в /secret/ (там адмінка). #}
{% if siteStatus.closed and not isSecretPage %}
<div class="maintenance-overlay" id="maintenanceOverlay" data-nosnippet role="dialog" aria-modal="true" aria-labelledby="maintenanceTitle">
  <div class="maintenance-box">
    <span class="eyebrow">Технічні роботи</span>
    <h2 id="maintenanceTitle" class="maintenance-title">Сайт тимчасово закрито</h2>
    <p class="maintenance-contact">Зв'язок: <a href="mailto:krzhv@proton.me">krzhv@proton.me</a></p>
    <p class="maintenance-urgent">Термінова допомога: <strong>103</strong> або <strong>112</strong></p>
  </div>
  <div class="maintenance-hidden-toggle" id="maintenanceToggle"></div>
</div>
<script>
  (function () {
    var KEY = 'krzhv_maintenance_bypass';
    var overlay = document.getElementById('maintenanceOverlay');
    var parts = document.querySelectorAll('.skip-link, .site-header, .site-notice, main, .site-footer');
    function lock(on) {
      for (var i = 0; i < parts.length; i++) { if (on) parts[i].setAttribute('inert', ''); else parts[i].removeAttribute('inert'); }
    }
    var open = false;
    try { open = localStorage.getItem(KEY) === '1'; } catch (e) {}
    if (open) { overlay.style.display = 'none'; } else { lock(true); }
    document.getElementById('maintenanceToggle').addEventListener('click', function () {
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
      overlay.style.display = 'none';
      lock(false);
    });
  })();
</script>
{% endif %}

