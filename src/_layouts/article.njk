---
layout: base.njk
ogType: article
---
{% set breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Головна", "item": "https://krzhv.com.ua/"},
    {"@type": "ListItem", "position": 2, "name": sectionLabel, "item": "https://krzhv.com.ua/" + section + "/"},
    {"@type": "ListItem", "position": 3, "name": title, "item": "https://krzhv.com.ua" + page.url}
  ]
} %}
<script type="application/ld+json">{{ breadcrumbSchema | dump | safe }}</script>
<div class="article-wrap">
  <div class="breadcrumb">
    <a href="/">Головна</a><span>/</span><a href="/{{ section }}/">{{ sectionLabel }}</a><span>/</span><span>{{ title }}</span>
  </div>

  <div class="article-header">
    <span class="eyebrow">{{ category }}</span>
    <h1>{{ title }}</h1>
    <div class="article-meta">
      <div class="author-chip">
        <picture>
          <source srcset="/assets/images/profile/sergiy-avatar.webp" type="image/webp">
          <img src="/assets/images/profile/sergiy-avatar.jpg" alt="Сергій Коржов" width="32" height="32" class="author-avatar" style="object-fit:cover;">
        </picture>
        <span>Сергій Коржов</span>
      </div>
      <div class="article-meta-item">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9.5h18M8 3v3M16 3v3"/></svg>
        <span>Оновлено {{ date | ukDate }}</span>
      </div>
      <div class="article-meta-item">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
        <span>{{ content | readingTime }} хв читання</span>
      </div>
    </div>
  </div>

  <div class="article-body">
    {{ content | safe }}

    <div class="author-box">
      <picture>
        <source srcset="/assets/images/profile/sergiy-author.webp" type="image/webp">
        <img src="/assets/images/profile/sergiy-author.jpg" alt="Сергій Коржов" width="64" height="64" class="author-photo" style="object-fit:cover;">
      </picture>
      <div>
        <h4>Сергій Коржов</h4>
        <p>Клінічний психолог, працюю в підході КПТ. Допомагаю людям онлайн.</p>
        <a href="/#about" class="btn-ghost">Про мене →</a>
      </div>
    </div>

    {% if sources %}
    <div class="sources">
      <h3>Джерела</h3>
      <ol>
        {% for src in sources %}<li>{{ src }}</li>{% endfor %}
      </ol>
    </div>
    {% endif %}
  </div>
</div>

{% set related = [] %}
{% for post in collections.statti %}
  {% if post.url != page.url and post.data.category == category %}
    {% set related = (related.push(post), related) %}
  {% endif %}
{% endfor %}
{% if related.length < 3 %}
  {% for post in collections.statti %}
    {% if post.url != page.url and post.data.category != category and related.length < 3 %}
      {% set related = (related.push(post), related) %}
    {% endif %}
  {% endfor %}
{% endif %}
<section class="related">
  <h3 class="related-head" style="max-width:1080px;margin:0 auto 32px;padding:0 32px;">Читайте також</h3>
  <div class="related-grid">
    {% for post in related %}
      {% if loop.index <= 3 %}
      <a href="{{ post.url }}" class="related-card">
        <span class="related-tag">{{ post.data.category }}</span>
        <h4>{{ post.data.title }}</h4>
      </a>
      {% endif %}
    {% endfor %}
  </div>
</section>

<div class="wrap">
  <div class="cta-band">
    <h2>Потрібна підтримка фахівця?</h2>
    <p>Якщо це відгукується — я можу допомогти. Напишіть мені, і ми обговоримо, з чого почати.</p>
    <a href="/#contact" class="cta-btn">Записатись на консультацію</a>
  </div>
</div>
